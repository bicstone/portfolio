{
  "extends": ["github>bicstone/renovate-config"],
  "packageRules": [
    {
      "groupName": "dependencies",
      "matchDepTypes": ["dependencies"],
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "dependencies",
      "matchPackageNames": ["@mui/lab{/,}**"],
      "matchUpdateTypes": ["major", "minor", "patch"]
    },
    {
      "description": "eslint-plugin-react と eslint-plugin-jsx-a11y が ESLint v10 に未対応のため、対応されるまで v9 系に固定する",
      "matchPackageNames": ["eslint", "@eslint/js"],
      "allowedVersions": "<10"
    }
  ]
}
