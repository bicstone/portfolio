---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const siteTitle = "大石貴則 (@bicstone)";
const ogImage = "https://static.bicstone.me/og_image.png";

const { props } = Astro;
const {
  title,
  description = "ものづくりの現場から来た、仕様まで読むWebエンジニア大石貴則 (@bicstone)のポートフォリオです。",
} = props;

const fullTitle = title === undefined ? siteTitle : `${title} - ${siteTitle}`;
const pathname = Astro.url.pathname
  .replace(/\.html$/v, "")
  .replace(/\/index$/v, "/");
const canonical = new URL(pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content="telephone=no" name="format-detection" />
    <meta content="light dark" name="color-scheme" />
    <meta
      content="#ffffff"
      media="(prefers-color-scheme: light)"
      name="theme-color"
    />
    <meta
      content="#1a1a1a"
      media="(prefers-color-scheme: dark)"
      name="theme-color"
    />
    <title>{fullTitle}</title>
    <meta content={description} name="description" />
    <link href={canonical} rel="canonical" />
    <link
      href="https://static.bicstone.me/favicon.ico"
      rel="icon"
      sizes="32x32"
    />
    <link
      href="https://static.bicstone.me/favicon.svg"
      rel="icon"
      type="image/svg+xml"
    />
    <link
      href="https://static.bicstone.me/apple-touch-icon.png"
      rel="apple-touch-icon"
    />
    <meta content="bicstone" name="apple-mobile-web-app-title" />
    <meta content="website" property="og:type" />
    <meta content={siteTitle} property="og:site_name" />
    <meta content={fullTitle} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={canonical} property="og:url" />
    <meta content={ogImage} property="og:image" />
    <meta content={siteTitle} property="og:image:alt" />
    <meta content="ja_JP" property="og:locale" />
    <meta content="summary" name="twitter:card" />
    <meta content="@bicstone_me" name="twitter:site" />
  </head>
  <body>
    <slot />
  </body>
</html>
